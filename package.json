{
  "name": "presslay-media-player",
  "productName": "Presslay Media Player",
  "version": "1.0.0",
  "description": "Presslay Media Player",
  "author": "Presslay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.presslay.mediaplayer",
    "productName": "Presslay Media Player",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "renderer/**", "build/icon.png", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Presslay Media Player"
    },
    "fileAssociations": [
      { "ext": ["mp3", "wav", "flac", "ogg", "m4a", "aac", "opus"], "name": "Audio file", "role": "Player" }
    ]
  }
}
